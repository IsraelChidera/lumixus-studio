# Lead handling (see integrations/google-apps-script/README.md). Both are optional.
# Set them in Netlify: Site configuration -> Environment variables.
# For local testing, copy to .env.local (which git ignores).

# Apps Script web app URL. Leave empty to use the existing deployment built into app/api/leads/route.ts.
LEADS_WEBHOOK_URL=
# Must match SHARED_SECRET in leads.gs if you set one there.
LEADS_WEBHOOK_SECRET=
